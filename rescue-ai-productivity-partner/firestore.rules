rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        && (data.email is string || data.email == null)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('settings' in data.keys()) || (data.settings is map));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
                    && isValidId(userId) 
                    && request.auth.uid == userId
                    && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password')
                    && isValidUser(incoming())
                    && (incoming().email == request.auth.token.email || incoming().email == null)
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      
      allow update: if isSignedIn() 
                    && isValidId(userId) 
                    && request.auth.uid == userId
                    && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password')
                    && isValidUser(incoming())
                    && incoming().email == existing().email
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && incoming().diff(existing()).affectedKeys().hasOnly(['settings', 'updatedAt']);
    }
  }
}
